VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxxxx.ingest.us.sentry.io/xxxxxxxxxx

# Selects the AI Gateway's active provider (src/ai/config/aiGatewayConfig.ts).
# Defaults to "local-rule" (the deterministic rule-based engine) if unset.
# Set to "claude" to route AiCoachSection's "unknown"-intent fallback (once
# a user opts in via Settings) through supabase/functions/ai-coach. This is
# a PUBLIC build-time selector only -- it never holds a real API key.
# ANTHROPIC_API_KEY itself is set separately, server-side only, via
# supabase secrets set ANTHROPIC_API_KEY=... -- never here, never as any
# VITE_ variable.
VITE_AI_PROVIDER=claude
